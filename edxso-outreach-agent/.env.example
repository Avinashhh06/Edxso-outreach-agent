# ---- LLM (pick ONE provider; leave blank to use offline template mode) ----
# LLM_PROVIDER: gemini | openai_compatible | none
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
# Only for openai_compatible (OpenAI, Groq, Together, Ollama...). Examples:
#   OpenAI : https://api.openai.com/v1
#   Groq   : https://api.groq.com/openai/v1
#   Ollama : http://localhost:11434/v1
LLM_BASE_URL=

# ---- Sending layer (Gmail SMTP with an App Password) ----
# SEND_MODE: dry_run (default, nothing leaves your machine) | live
SEND_MODE=dry_run
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
FROM_EMAIL=
# While testing in live mode, every email is redirected to this address instead of the influencer.
TEST_RECIPIENT=

# ---- Database / API ----
DB_PATH=outputs/outreach.db
